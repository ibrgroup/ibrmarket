# URL фронтенда (редирект после оплаты ЮKassa). Пример: http://localhost:3000 или https://ibr-market.com
FRONTEND_URL=

# PORT — порт, на котором будет запущен сервер Node.js.
# Обычно 8000 или 3000 для разработки. Можно указать любой свободный порт.
PORT=

# MONGODB_URI — строка подключения к базе данных MongoDB.
# Получить можно в панели управления MongoDB Atlas или вашей локальной MongoDB.
MONGODB_URI=

# EMAIL — почта, с которой будут отправляться сервисные письма (например, подтверждение регистрации, восстановление пароля).
# Указать вашу рабочую почту (например, Gmail, Yandex, Mail.ru и т.д.).
EMAIL=

# EMAIL_PASS — пароль или специальный app password для доступа к почтовому ящику.
# Для Gmail и других сервисов может потребоваться создать отдельный пароль для приложения.
EMAIL_PASS=

# JSON_WEB_TOKEN_SECRET_KEY — секретный ключ для подписи JWT токенов.
# Должен быть длинной случайной строкой. Сгенерировать можно с помощью любого генератора паролей.
JSON_WEB_TOKEN_SECRET_KEY=""

# SECRET_KEY_ACCESS_TOKEN — секрет для генерации access токенов (короткоживущих).
# Должен быть уникальным и сложным. Сгенерировать самостоятельно.
SECRET_KEY_ACCESS_TOKEN=''

# SECRET_KEY_REFRESH_TOKEN — секрет для генерации refresh токенов (долгоживущих).
# Должен отличаться от access token и быть уникальным.
SECRET_KEY_REFRESH_TOKEN=''

# cloudinary_Config_Cloud_Name — имя вашего облака в Cloudinary.
# Получить можно в личном кабинете Cloudinary (Cloud Name).
cloudinary_Config_Cloud_Name=""

# cloudinary_Config_api_key — API ключ Cloudinary.
# Получить в настройках аккаунта Cloudinary (API Key).
cloudinary_Config_api_key=""

# cloudinary_Config_api_secret — секретный ключ Cloudinary.
# Получить в настройках аккаунта Cloudinary (API Secret).
cloudinary_Config_api_secret=""

# ЮKassa (оплата заказов)
# Получить в личном кабинете ЮKassa: https://yookassa.ru/my
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Общий ключ для вызовов Next.js → Express (сохранение карт и т.д.). Должен совпадать с INTERNAL_API_KEY на фронте.
INTERNAL_API_KEY=

# Демо-вход по фиксированному OTP (только для презентаций). В продакшене не включать.
# Существующий пользователь: запросите код как обычно, затем вместо SMS введите DEMO_OTP_CODE.
# DEMO_MASTER_OTP=true
# DEMO_OTP_CODE=555555